{
  "name": "statiku",
  "version": "0.1.0",
  "private": true,
  "description": "Live analytics for websites, SaaS and apps, from the first visit to the purchase.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node tracker/build.ts",
    "geo": "node scripts/geo.ts",
    "migrate": "node db/migrate.ts",
    "start": "node ingest/server.ts",
    "dev": "node --watch --env-file-if-exists=.env ingest/server.ts",
    "project": "node --env-file-if-exists=.env scripts/project.ts",
    "stats": "node --env-file-if-exists=.env scripts/stats.ts",
    "billing": "node --env-file-if-exists=.env scripts/billing.ts",
    "demo": "node scripts/demo.ts",
    "test": "node --test --test-concurrency=1 --env-file-if-exists=.env test/",
    "e2e": "node --env-file-if-exists=.env scripts/e2e-notchlight.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "d3-geo": "^3.1.1",
    "esbuild": "^0.28.2",
    "mmdb-lib": "^3.0.3",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "simple-icons": "^16.35.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/topojson-client": "^3.1.5",
    "i18n-iso-countries": "^7.14.0",
    "puppeteer-core": "^25.14.0",
    "typescript": "^7.0.2"
  }
}
